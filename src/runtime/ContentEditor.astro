---
/**
 * The editor for a header/footer part or a template body (ADR 0041), on the Template Management page
 * (`?edit=<id>`, admins): the full Tapestry editor, saved through /_tapestry/parts (not StudioCMS's page
 * form). The canvas shows it in place on a real page (the home page, else the first page): a part in
 * its region with the page's content as a placeholder; a template's body (its content areas labelled)
 * between its header and footer.
 */
/// <reference types="studiocms/v/types" />
/// <reference path="../virtual.d.ts" />
import '../editor/editor.css';
import { runSDK, SDKCoreJs } from 'studiocms:sdk';
import config from 'virtual:tapestry/config';
import manifest from 'virtual:tapestry/manifest';
import { hasPermission, pagePath } from '../access.js';
import { storedModes } from '../modes.js';
import type { PartRecord, TemplateRecord } from '../templates.js';
import { loadModes } from './modes-store.js';
import { getStoredContent } from './templates-store.js';
import { loadToolbarSettings } from './toolbar-store.js';
import { getViewer } from './viewer.js';

interface Props {
	subject: PartRecord | TemplateRecord;
	/** The list it came from (back link). */
	back: string;
}
const { subject, back } = Astro.props;
const isPart = 'region' in subject;
const content = (await getStoredContent(subject.id)) ?? '';
const toolbars = JSON.stringify(await loadToolbarSettings(manifest));
const viewer = await getViewer(Astro);
const canPublish = hasPermission(viewer.permissionLevel, config.publishPermission);
const locals = Astro.locals as { StudioCMS?: { security?: { userSessionData?: { user?: { name?: string } | null } } } };
const userName = locals.StudioCMS?.security?.userSessionData?.user?.name ?? '';

// The canvas page: the home page, else the first page (any type; editors see drafts in the canvas).
async function canvasPage(): Promise<string | null> {
	try {
		const pages = (await runSDK(SDKCoreJs.GET.pages(true, true))) as unknown as Array<{ slug: string }>;
		const list = Array.isArray(pages) ? pages : [];
		const page = list.find((p) => p.slug === 'index') ?? list[0];
		return page ? pagePath(config.pageUrlPattern, String(page.slug)) : null;
	} catch {
		return null;
	}
}
// Display modes (ADR 0046): none unless a companion (Tapestry Fabric) turns them on.
const modes = await loadModes();
const modesData = modes.length > 0 ? JSON.stringify(storedModes(modes).modes) : '';
const canvas = await canvasPage();
const kindLabel = isPart ? (subject.region === 'header' ? 'Header' : 'Footer') : 'Template';
const backLabel = isPart ? '← Headers and Footers' : '← Templates';
---

<div class="tapestry-content-editor" data-tapestry-content-editor>
	<p class="tapestry-content-editor__intro">
		<a href={back} data-tapestry-content-back>{backLabel}</a>
		<span>
			{kindLabel}: <strong>{subject.name}</strong>.{' '}
			{isPart
				? 'Publishing it updates every page that shows it.'
				: 'Add Content areas where pages put their content; the rest is the same on every page using this template. Publishing updates them all.'}
		</span>
	</p>
	{!canvas && (
		<p class="tapestry-content-editor__intro" role="note">
			Create a page first: the canvas shows this on one of your pages.
		</p>
	)}
	<div
		class="tapestry-editor-host"
		data-tapestry-editor
		data-subject-kind={isPart ? 'part' : 'template'}
		data-subject-id={subject.id}
		data-subject-name={subject.name}
		data-subject-region={isPart ? subject.region : ''}
		data-canvas-page={canvas ?? ''}
		data-user-name={userName}
		data-toolbars={toolbars}
		data-can-publish={canPublish ? 'true' : 'false'}
		data-publish-role={config.publishPermission}
		data-user-level={viewer.permissionLevel}
		data-modes={modesData}
	></div>
	<textarea class="tapestry-editor-field" data-tapestry-field aria-label={`${kindLabel} content (JSON)`} spellcheck="false"
		>{content}</textarea
	>
</div>

<script>
	import config from 'virtual:tapestry/config';
	import { loadPicker } from 'virtual:tapestry/media-client';
	import manifest from 'virtual:tapestry/manifest';
	import thumbnails from 'virtual:tapestry/thumbnails';
	import { mountEditor } from '../editor/mount.js';
	import { parseModes } from '../modes.js';
	import { applyToolbarSettings, parseToolbarSettings } from '../toolbar-settings.js';

	function toolbarSettings(raw: string | undefined) {
		try {
			return parseToolbarSettings(JSON.parse(raw ?? '{}'), manifest);
		} catch {
			return parseToolbarSettings({}, manifest);
		}
	}

	/** The site's display modes, or none (off). */
	function displayModes(raw: string | undefined) {
		if (!raw) return [];
		try {
			return parseModes({ modes: JSON.parse(raw) });
		} catch {
			return parseModes(null);
		}
	}

	let cleanup: (() => void) | undefined;

	function init() {
		const host = document.querySelector<HTMLElement>('[data-tapestry-content-editor] [data-tapestry-editor]');
		const field = document.querySelector<HTMLTextAreaElement>(
			'[data-tapestry-content-editor] textarea[data-tapestry-field]',
		);
		const id = host?.dataset.subjectId;
		if (!host || !field || !id) return;
		const kind = host.dataset.subjectKind === 'template' ? 'template' : 'part';
		const region = host.dataset.subjectRegion === 'footer' ? 'footer' : 'header';
		cleanup =
			mountEditor(host, field, applyToolbarSettings(manifest, toolbarSettings(host.dataset.toolbars)), {
				pageUrlPattern: config.pageUrlPattern,
				renderRoute: config.renderRoute,
				historyLimit: config.historyLimit,
				userName: host.dataset.userName || undefined,
				canPublish: host.dataset.canPublish !== 'false',
				publishRole: host.dataset.publishRole,
				mediaPicker: loadPicker,
				thumbnails,
				userLevel: host.dataset.userLevel,
				subject: { kind, id, name: host.dataset.subjectName ?? '', ...(kind === 'part' ? { region } : {}) },
				canvasPage: host.dataset.canvasPage || null,
				modes: displayModes(host.dataset.modes),
			}) ?? cleanup;
		field.hidden = true;
	}

	init();
	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', () => {
		cleanup?.();
		cleanup = undefined;
	});
</script>

<style>
	.tapestry-content-editor {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.tapestry-content-editor__intro {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0;
		line-height: 1.5;
	}
	.tapestry-content-editor__intro a {
		color: var(--primary-base, hsl(259 74% 45%));
	}
	.tapestry-editor-field {
		width: 100%;
		min-height: 20rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
</style>
