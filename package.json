{
  "name": "@nascencestudio/tapestry",
  "version": "0.1.1",
  "description": "Drag-and-drop component page building for Astro + StudioCMS",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/tapestry.git"
  },
  "homepage": "https://github.com/nascencestudio/tapestry#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/tapestry/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/runtime/page.d.ts",
      "default": "./dist/runtime/page.js"
    },
    "./AdminBar.astro": "./dist/runtime/AdminBar.astro",
    "./RichText.astro": "./dist/runtime/RichText.astro"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "audit": "pnpm audit --prod",
    "docs:dev": "pnpm --filter website dev",
    "docs:build": "pnpm --filter website build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "studiocms": "^0.6.0",
    "@nascencestudio/medialibrary": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@nascencestudio/medialibrary": {
      "optional": true
    }
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@preact/signals": "2.11.2",
    "preact": "10.29.8",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@libsql/client": "0.18.0",
    "@nascencestudio/medialibrary": "0.1.1",
    "@types/node": "22.20.4",
    "astro": "7.3.5",
    "studiocms": "0.6.1",
    "typescript": "6.0.3",
    "ultrahtml": "1.7.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "page-builder",
    "visual-editor",
    "drag-and-drop"
  ]
}
