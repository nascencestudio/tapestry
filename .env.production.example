# Copy to .env.production on the server (chmod 600) and fill in. Never commit it.

# Public domain; Caddy gets an HTTPS certificate for it automatically.
# Point the domain's DNS A/AAAA records at the server first.
SITE_DOMAIN=example.com

# Encrypts StudioCMS secrets. Generate with: openssl rand --base64 16
CMS_ENCRYPTION_KEY=

# The database and media paths are set in compose.yaml (the /data volume).

# Optional: the highest upload size (in MB) admins can set in
# Plugins → Media Library. Caddy's request limit follows it. Default 1024.
# MEDIA_MAX_UPLOAD_MB=1024
