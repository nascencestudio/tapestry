---
/**
 * Template Management (ADR 0041), a dashboard page under Media: editors can look (to know what the
 * Template menu offers), admins can change things (the endpoints check it too). **Headers and Footers**
 * (create, rename, edit, delete shared parts) and **Templates**
 * (page layouts: name, header, footer, edit the body). `?edit=<id>` opens a part or a template in the
 * full editor (ContentEditor.astro). The lists are plain forms posting to /_tapestry/templates, which
 * redirects back with `saved` or an error code.
 */
/// <reference path="../virtual.d.ts" />
import config from 'virtual:tapestry/config';
import manifest from 'virtual:tapestry/manifest';
import { hasPermission } from '../access.js';
import { pageStatus } from '../revisions.js';
import { TEMPLATES_ROUTE } from '../routes.js';
import {
	PART_ID,
	REGIONS,
	TEMPLATE_ERRORS,
	TEMPLATE_ID,
	type TemplateError,
	templateAreas,
	templatesUsing,
} from '../templates.js';
import ContentEditor from './ContentEditor.astro';
import { getPart, getTemplate, listParts, listTemplates } from './templates-store.js';
import { getViewer } from './viewer.js';

const here = Astro.url.pathname;
const viewer = await getViewer(Astro);
const isAdmin = hasPermission(viewer.permissionLevel, 'admin');
const view = Astro.url.searchParams.get('view') === 'templates' ? 'templates' : 'parts';
const editId = Astro.url.searchParams.get('edit') ?? '';
const editing = !isAdmin
	? null
	: PART_ID.test(editId)
		? await getPart(editId, manifest, config.historyLimit)
		: TEMPLATE_ID.test(editId)
			? await getTemplate(editId, manifest, config.historyLimit)
			: null;
const [templates, parts] = await Promise.all([
	listTemplates(manifest, config.historyLimit),
	listParts(manifest, config.historyLimit),
]);
const returnTo = view === 'templates' ? `${here}?view=templates` : here;
const saved = Astro.url.searchParams.has('saved');
const errorCode = Astro.url.searchParams.get('error');
const error = errorCode && errorCode in TEMPLATE_ERRORS ? TEMPLATE_ERRORS[errorCode as TemplateError] : null;
const missing = editId && !editing;
const LABEL = { header: 'Header', footer: 'Footer' } as const;
const STATUS = { unpublished: 'Not published', published: 'Published', changed: 'Unpublished changes' } as const;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

{
	editing ? (
		<ContentEditor
			subject={editing}
			back={'region' in editing ? here : `${here}?view=templates`}
		/>
	) : (
		<div class="tapestry-templates" data-tapestry-templates-settings data-view={view}>
			{saved && <p class="tapestry-templates__notice" role="status" data-tapestry-templates-saved>Saved.</p>}
			{!isAdmin && (
				<p class="tapestry-templates__notice" role="note" data-tapestry-templates-readonly>
					Only admins can change templates, headers and footers. You can choose them for a page in the editor's
					Template menu.
				</p>
			)}
			{(error || missing) && (
				<p class="tapestry-templates__notice tapestry-templates__notice--error" role="alert" data-tapestry-templates-error>
					{error ?? 'That header, footer or template no longer exists.'}
				</p>
			)}

			{view === 'parts' ? (
				<section class="tapestry-templates__group" aria-labelledby="tp-parts-title">
					<h2 class="tapestry-templates__title" id="tp-parts-title">Headers and Footers</h2>
					<p class="tapestry-templates__muted">
						Built once, like pages, and used by templates and by pages without a template. Your site's layout places
						them with <code>&lt;Region name="header" page=&#123;result&#125; /&gt;</code> and{' '}
						<code>name="footer"</code>.
					</p>
					{REGIONS.map((region) => {
						const list = parts.filter((p) => p.region === region);
						return (
							<div class="tapestry-templates__region" data-tapestry-parts={region}>
								<h3 class="tapestry-templates__subtitle">{LABEL[region]}s</h3>
								{list.length === 0 && <p class="tapestry-templates__muted">No {region}s yet.</p>}
								<ul class="tapestry-templates__list">
									{list.map((part) => {
										const users = templatesUsing(part.id, templates).length;
										return (
											<li class="tapestry-templates__item" data-tapestry-part={part.id}>
												<div class="tapestry-templates__row">
													<strong class="tapestry-templates__name">{part.name}</strong>
													<span class="tapestry-templates__status" data-status={pageStatus(part.page)}>
														{STATUS[pageStatus(part.page)]}
													</span>
													<span class="tapestry-templates__muted">
														{users === 0 ? 'Not used by a template' : `Used by ${users} template${users === 1 ? '' : 's'}`}
													</span>
													{isAdmin && (
<a class="tapestry-templates__button tapestry-templates__button--primary" href={`${here}?edit=${part.id}`} data-tapestry-part-edit>
														Edit
													</a>
)}
												</div>
												{isAdmin && (
<div class="tapestry-templates__row">
													<form method="post" action={TEMPLATES_ROUTE} class="tapestry-templates__inline">
														<input type="hidden" name="return" value={returnTo} />
														<input type="hidden" name="action" value="rename-part" />
														<input type="hidden" name="id" value={part.id} />
														<label class="tapestry-templates__sr-only" for={`tp-rename-${part.id}`}>Name of {part.name}</label>
														<input id={`tp-rename-${part.id}`} class="tapestry-templates__input" name="name" value={part.name} maxlength="80" required />
														<button type="submit" class="tapestry-templates__button">Rename</button>
													</form>
													<form method="post" action={TEMPLATES_ROUTE}>
														<input type="hidden" name="return" value={returnTo} />
														<input type="hidden" name="action" value="delete-part" />
														<input type="hidden" name="id" value={part.id} />
														<button
															type="submit"
															class="tapestry-templates__button tapestry-templates__button--danger"
															disabled={users > 0}
															title={users > 0 ? 'Used by a template: choose another part there first' : undefined}
															data-tapestry-part-delete
														>
															Delete
														</button>
													</form>
												</div>
)}
											</li>
										);
									})}
								</ul>
							</div>
						);
					})}
					{isAdmin && (
<form method="post" action={TEMPLATES_ROUTE} class="tapestry-templates__create" data-tapestry-part-create>
						<input type="hidden" name="return" value={returnTo} />
						<input type="hidden" name="action" value="create-part" />
						<label class="tapestry-templates__field">
							<span>New header or footer</span>
							<input class="tapestry-templates__input" name="name" placeholder="e.g. Main header" maxlength="80" required />
						</label>
						<label class="tapestry-templates__field">
							<span>Region</span>
							<select class="tapestry-templates__input" name="region">
								<option value="header">Header</option>
								<option value="footer">Footer</option>
							</select>
						</label>
						<button type="submit" class="tapestry-templates__button">Create</button>
					</form>
)}
				</section>
			) : (
				<section class="tapestry-templates__group" aria-labelledby="tp-templates-title">
					<h2 class="tapestry-templates__title" id="tp-templates-title">Templates</h2>
					<p class="tapestry-templates__muted">
						Page layouts that pages inherit: a header, a footer and a body of your own, built in the editor. Add one or
						more <strong>Content areas</strong> to the body: that's where pages put their content. Everything else is
						the same on every page using the template.
					</p>
					{templates.length === 0 && <p class="tapestry-templates__muted">No templates yet.</p>}
					<ul class="tapestry-templates__list">
						{templates.map((template) => {
							const areas = templateAreas(template.page.published ?? template.page.draft);
							return (
								<li class="tapestry-templates__item tapestry-templates__item--with-bar" data-tapestry-template-row={template.id}>
									<div class="tapestry-templates__row">
										<strong class="tapestry-templates__name">{template.name}</strong>
										<span class="tapestry-templates__status" data-status={pageStatus(template.page)}>
											{STATUS[pageStatus(template.page)]}
										</span>
									</div>
									{isAdmin && (
										<form method="post" action={TEMPLATES_ROUTE} class="tapestry-templates__inline tapestry-templates__inline--wrap">
											<input type="hidden" name="return" value={returnTo} />
											<input type="hidden" name="action" value="update-template" />
											<input type="hidden" name="id" value={template.id} />
											<label class="tapestry-templates__field">
												<span>Name</span>
												<input class="tapestry-templates__input" name="name" value={template.name} maxlength="80" required />
											</label>
											{REGIONS.map((region) => (
												<label class="tapestry-templates__field">
													<span>{LABEL[region]}</span>
													<select class="tapestry-templates__input" name={region} data-tapestry-template-region={region}>
														<option value="">None</option>
														{parts
															.filter((p) => p.region === region)
															.map((p) => (
																<option value={p.id} selected={template[region] === p.id}>
																	{p.name}
																</option>
															))}
													</select>
												</label>
											))}
											<button type="submit" class="tapestry-templates__button">Save</button>
										</form>
									)}
									<div class="tapestry-templates__bar">
										<span class="tapestry-templates__bar-status" data-tapestry-template-areas>
											{areas.length === 0 ? 'No content areas yet' : `Areas: ${areas.map((a) => a.name).join(', ')}`}
										</span>
										{isAdmin && (
											<>
												<a class="tapestry-templates__button tapestry-templates__button--primary" href={`${here}?edit=${template.id}`} data-tapestry-template-edit>
													Edit layout
												</a>
												<form method="post" action={TEMPLATES_ROUTE}>
													<input type="hidden" name="return" value={returnTo} />
													<input type="hidden" name="action" value="delete-template" />
													<input type="hidden" name="id" value={template.id} />
													<button type="submit" class="tapestry-templates__button tapestry-templates__button--danger" data-tapestry-template-delete>
														Delete template
													</button>
												</form>
											</>
										)}
									</div>
								</li>
							);
						})}
					</ul>
					{isAdmin && (
<form method="post" action={TEMPLATES_ROUTE} class="tapestry-templates__create" data-tapestry-template-create>
						<input type="hidden" name="return" value={returnTo} />
						<input type="hidden" name="action" value="create-template" />
						<label class="tapestry-templates__field">
							<span>New template</span>
							<input class="tapestry-templates__input" name="name" placeholder="e.g. Article" maxlength="80" required />
						</label>
						{REGIONS.map((region) => (
							<label class="tapestry-templates__field">
								<span>{LABEL[region]}</span>
								<select class="tapestry-templates__input" name={region}>
									<option value="">None</option>
									{parts.filter((p) => p.region === region).map((p) => <option value={p.id}>{p.name}</option>)}
								</select>
							</label>
						))}
						<button type="submit" class="tapestry-templates__button">Create</button>
					</form>
)}
				</section>
			)}
		</div>
	)
}

<style>
	.tapestry-templates {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 60rem;
	}
	.tapestry-templates__notice {
		margin: 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid var(--success-base, hsl(142 60% 35%));
	}
	.tapestry-templates__notice--error {
		border-color: var(--danger-base, hsl(339 80% 50%));
	}
	.tapestry-templates__group {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		padding: 1rem;
		border: 1px solid var(--border, hsl(263 5% 68%));
		border-radius: 0.5rem;
	}
	.tapestry-templates__title {
		margin: 0;
		font-size: 1.125rem;
	}
	.tapestry-templates__subtitle {
		margin: 0 0 0.5rem;
		font-size: 1rem;
	}
	.tapestry-templates__list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tapestry-templates__item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.75rem;
		border-radius: 0.5rem;
		background: var(--background-step-1, transparent);
	}
	.tapestry-templates__row,
	.tapestry-templates__inline,
	.tapestry-templates__create {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}
	.tapestry-templates__inline--wrap,
	.tapestry-templates__create {
		align-items: flex-end;
	}
	.tapestry-templates__name {
		margin-right: auto;
	}
	.tapestry-templates__muted {
		margin: 0;
		color: var(--text-muted, inherit);
		font-size: 0.875rem;
		line-height: 1.5;
	}
	.tapestry-templates__status {
		padding: 0.05rem 0.5rem;
		font-size: 0.75rem;
		border: 1px solid var(--border, hsl(263 5% 68%));
		border-radius: 999px;
	}
	.tapestry-templates__status[data-status='published'] {
		border-color: var(--success-base, hsl(142 60% 35%));
	}
	.tapestry-templates__status[data-status='changed'] {
		border-color: var(--warning-base, hsl(38 92% 50%));
	}
	.tapestry-templates__field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.875rem;
	}
	.tapestry-templates__field > span {
		font-weight: 600;
	}
	.tapestry-templates__input {
		font: inherit;
		padding: 0.4rem 0.6rem;
		border-radius: 0.375rem;
		border: 1px solid var(--border, hsl(263 5% 68%));
		background: var(--background-base, transparent);
		color: inherit;
	}
	.tapestry-templates__button {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		font: inherit;
		font-size: 0.875rem;
		padding: 0.4rem 0.8rem;
		border-radius: 0.375rem;
		border: 1px solid var(--border, hsl(263 5% 68%));
		background: transparent;
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}
	.tapestry-templates__button:disabled {
		opacity: 0.55;
		cursor: default;
	}
	.tapestry-templates__button--danger {
		color: #fff;
		background: var(--danger-base, hsl(339 80% 45%));
		border-color: var(--danger-base, hsl(339 80% 45%));
	}
	.tapestry-templates__button--danger:hover:not(:disabled) {
		filter: brightness(1.1);
	}
	.tapestry-templates__item--with-bar {
		padding-bottom: 0;
		overflow: hidden;
	}
	.tapestry-templates__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0.25rem -0.75rem 0;
		padding: 0.6rem 0.75rem;
		background: var(--background-step-2, rgb(0 0 0 / 0.08));
		border-top: 1px solid var(--border, hsl(263 5% 68%));
	}
	.tapestry-templates__bar-status {
		margin-right: auto;
		color: var(--text-muted, inherit);
		font-size: 0.875rem;
	}
	.tapestry-templates__button--primary {
		color: var(--text-inverted, #fff);
		background: var(--primary-base, hsl(259 74% 45%));
		border-color: var(--primary-base, hsl(259 74% 45%));
	}
	.tapestry-templates__button:focus-visible,
	.tapestry-templates__input:focus-visible {
		outline: 2px solid var(--primary-base, hsl(259 74% 45%));
		outline-offset: 2px;
	}
	.tapestry-templates__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}
</style>
