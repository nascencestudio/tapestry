---
interface Props {
	count?: number;
}
const { count = 2 } = Astro.props;
---

<div class="columns" style={{ '--columns': count }}>
	<slot />
</div>

<style>
	.columns {
		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		gap: 1.5rem;
	}
	@media (max-width: 700px) {
		.columns {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
