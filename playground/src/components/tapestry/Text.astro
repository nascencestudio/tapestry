---
import type { RichTextDoc } from '@nascencestudio/tapestry';
import RichText from '@nascencestudio/tapestry/RichText.astro';

interface Props {
	body: RichTextDoc;
}
const { body } = Astro.props;
---

<div class="text">
	<RichText value={body} />
</div>

<style>
	.text :global(p),
	.text :global(ul),
	.text :global(ol) {
		margin: 0 0 1em;
		line-height: 1.6;
	}
	.text :global(ul),
	.text :global(ol) {
		padding-left: 1.5em;
	}
	.text :global(li > p) {
		margin: 0;
	}
	.text :global(:is(h1, h2, h3, h4, h5, h6)) {
		margin: 1.5em 0 0.5em;
		line-height: 1.25;
	}
	.text :global(h1) {
		font-size: 2rem;
	}
	.text :global(h2) {
		font-size: 1.625rem;
	}
	.text :global(h3) {
		font-size: 1.25rem;
	}
	.text :global(h4) {
		font-size: 1.125rem;
	}
	.text :global(:is(h5, h6)) {
		font-size: 1rem;
	}
	.text :global(blockquote) {
		margin: 0 0 1em;
		padding-left: 1em;
		border-left: 3px solid currentColor;
		opacity: 0.85;
	}
	.text :global(hr) {
		margin: 1.5em 0;
		border: 0;
		border-top: 1px solid currentColor;
		opacity: 0.3;
	}
	.text :global(a) {
		color: inherit;
		text-decoration: underline;
	}
	.text :global(:first-child) {
		margin-top: 0;
	}
	.text :global(:last-child) {
		margin-bottom: 0;
	}
</style>
